<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D8C9F4FA" android:centerColor="#C76DBBD2" android:endColor="#C72B7698" />
            <stroke android:width="1dp" android:color="#B9C9F5FF" />
        </shape>
    </item>
    <item android:gravity="top" android:height="2dp">
        <shape android:shape="rectangle"><solid android:color="#66FFFFFF" /></shape>
    </item>
    <item android:gravity="right|top" android:right="38dp" android:top="-25dp" android:width="120dp" android:height="70dp">
        <shape android:shape="oval"><solid android:color="#15FFFFFF" /></shape>
    </item>
</layer-list>
