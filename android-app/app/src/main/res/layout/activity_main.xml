<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/classic_face">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/classic_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="11dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Pixel Sheet Converter"
            android:textColor="@color/classic_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="15sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/soft_blue"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="ANDROID  0.2"
            android:textColor="@color/classic_blue"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="#000000"
                app:implementationMode="compatible"
                app:scaleType="fillCenter" />

            <ImageView
                android:id="@+id/resultPreview"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:adjustViewBounds="true"
                android:background="@drawable/preview_frame"
                android:padding="4dp"
                android:contentDescription="Anteprima convertita"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/captureButton"
                    style="@style/Widget.PixelSheet.ActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="SCATTA"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/galleryButton"
                    style="@style/Widget.PixelSheet.ActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:text="GALLERIA"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cameraSwitchButton"
                    style="@style/Widget.PixelSheet.ActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="CAMERA"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Zoom" android:textColor="@color/soft_text" android:textStyle="bold" />
            <SeekBar android:id="@+id/zoomSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Compensazione esposizione" android:textColor="@color/soft_text" android:textStyle="bold" />
            <SeekBar android:id="@+id/exposureSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="0" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <CheckBox android:id="@+id/flashCheck" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Flash" />
                <TextView android:id="@+id/cameraInfo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.7" android:gravity="end" android:maxLines="2" android:text="Fotocamera in preparazione" android:textColor="@color/soft_muted" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/soft_panel" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conversione" android:textColor="@color/classic_blue" android:textSize="17sp" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:text="Larghezza celle" />
                <EditText android:id="@+id/widthInput" android:layout_width="100dp" android:layout_height="wrap_content" android:inputType="number" android:text="240" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:text="Passo pixel (mm)" />
                <EditText android:id="@+id/pitchInput" android:layout_width="100dp" android:layout_height="wrap_content" android:inputType="numberDecimal" android:text="0.5" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Metrica colore" />
            <Spinner android:id="@+id/metricSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dithering" />
            <Spinner android:id="@+id/ditherSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/convertButton"
                style="@style/Widget.PixelSheet.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Converti immagine"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressTint="@color/classic_green" />

            <TextView
                android:id="@+id/statisticsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/preview_frame"
                android:padding="8dp"
                android:text="Scatta o importa un'immagine."
                android:textIsSelectable="true" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:baselineAligned="false" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/exportPngButton" style="@style/Widget.PixelSheet.ActionButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:enabled="false" android:text="PNG" />
                <com.google.android.material.button.MaterialButton android:id="@+id/exportXlsxButton" style="@style/Widget.PixelSheet.ActionButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:enabled="false" android:text="XLSX" />
                <com.google.android.material.button.MaterialButton android:id="@+id/backToCameraButton" style="@style/Widget.PixelSheet.ActionButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:text="CAMERA" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/soft_blue"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="Pronto"
        android:textColor="@color/soft_muted"
        android:textSize="12sp" />
</LinearLayout>
