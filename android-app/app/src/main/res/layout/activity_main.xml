<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/classic_face"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/msn_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Pixel Sheet Converter"
            android:textColor="@color/aero_title_text"
            android:fontFamily="sans-serif-light"
            app:autoSizeMaxTextSize="19sp"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/msn_toolbar"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="ANDROID 0.6"
            android:textColor="@color/classic_blue"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/msn_toolbar"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navCameraButton"
            style="@style/Widget.PixelSheet.NavButton"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="1  FOTOCAMERA" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navConvertButton"
            style="@style/Widget.PixelSheet.NavButton"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="2  CONVERSIONE" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navResultButton"
            style="@style/Widget.PixelSheet.NavButton"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="3  RISULTATO" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/screenFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. FOTOCAMERA -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#101214">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#101214"
                app:implementationMode="compatible"
                app:scaleType="fillCenter" />

            <it.sc4tto.pixelsheetconverter.CameraGridView
                android:id="@+id/cameraGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cameraTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/msn_camera_top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="Pixel Sheet · Fotocamera"
                    android:textColor="@color/classic_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <CheckBox
                    android:id="@+id/gridCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:buttonTint="@color/classic_white"
                    android:text="Griglia"
                    android:textColor="@color/classic_white" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cameraContinueButton"
                    style="@style/Widget.PixelSheet.CameraOverlayButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="5dp"
                    android:text="PARAMETRI" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cameraBottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/msn_camera_bottom"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <CheckBox
                        android:id="@+id/flashCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:buttonTint="@color/classic_white"
                        android:text="Flash"
                        android:textColor="@color/classic_white" />
                    <TextView
                        android:id="@+id/cameraInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:maxLines="2"
                        android:text="Fotocamera in preparazione"
                        android:textColor="#DDE7EC"
                        android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ZOOM" android:textColor="#DDE7EC" android:textSize="10sp" />
                <SeekBar android:id="@+id/zoomSeek" android:layout_width="match_parent" android:layout_height="32dp" android:max="100" android:progressTint="@color/classic_white" android:thumbTint="@color/classic_white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESPOSIZIONE" android:textColor="#DDE7EC" android:textSize="10sp" />
                <SeekBar android:id="@+id/exposureSeek" android:layout_width="match_parent" android:layout_height="32dp" android:max="0" android:progressTint="@color/classic_white" android:thumbTint="@color/classic_white" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:baselineAligned="false" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/galleryButton" style="@style/Widget.PixelSheet.CameraOverlayButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="GALLERIA" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/captureButton" style="@style/Widget.PixelSheet.CameraCaptureButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="5dp" android:layout_weight="1.35" android:text="SCATTA" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/cameraSwitchButton" style="@style/Widget.PixelSheet.CameraOverlayButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:text="CAMERA" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 2. CONVERSIONE -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView style="@style/Widget.PixelSheet.SectionTitle" android:text="2. Impostazioni conversione" />
                <ImageView
                    android:id="@+id/sourcePreview"
                    android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="8dp"
                    android:adjustViewBounds="true" android:background="@drawable/msn_preview_frame" android:contentDescription="Immagine originale"
                    android:padding="4dp" android:scaleType="fitCenter" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/msn_panel" android:orientation="vertical" android:padding="12dp">
                    <TextView style="@style/Widget.PixelSheet.PanelTitle" android:text="2.1 Dimensioni" />
                    <LinearLayout style="@style/Widget.PixelSheet.FieldRow">
                        <TextView style="@style/Widget.PixelSheet.FieldName" android:text="Larghezza in celle" />
                        <EditText android:id="@+id/widthInput" style="@style/Widget.PixelSheet.NumberInput" android:inputType="number" android:text="240" />
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.PixelSheet.FieldRow">
                        <TextView style="@style/Widget.PixelSheet.FieldName" android:text="Passo pixel (mm)" />
                        <EditText android:id="@+id/pitchInput" style="@style/Widget.PixelSheet.NumberInput" android:inputType="numberDecimal" android:text="0.5" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/msn_panel" android:orientation="vertical" android:padding="12dp">
                    <TextView style="@style/Widget.PixelSheet.PanelTitle" android:text="2.2 Colori e dithering" />
                    <TextView style="@style/Widget.PixelSheet.FieldLabel" android:layout_marginTop="8dp" android:text="Palette" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="#E54B45" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="#58A66C" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_weight="1" android:background="#466EB5" />
                    </LinearLayout>
                    <TextView style="@style/Widget.PixelSheet.FieldLabel" android:layout_marginTop="10dp" android:text="Metrica colore" />
                    <Spinner android:id="@+id/metricSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/input_frame" />
                    <TextView style="@style/Widget.PixelSheet.FieldLabel" android:layout_marginTop="10dp" android:text="Dithering" />
                    <Spinner android:id="@+id/ditherSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/input_frame" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/convertButton" style="@style/Widget.PixelSheet.PrimaryButton"
                    android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp"
                    android:text="GENERA CONVERSIONE" />
                <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="8dp"
                    android:max="100" android:progressTint="@color/classic_green" />
            </LinearLayout>
        </ScrollView>

        <!-- 3. RISULTATO -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView style="@style/Widget.PixelSheet.SectionTitle" android:text="3. Risultato ed esportazione" />
                <ImageView
                    android:id="@+id/resultPreview"
                    android:layout_width="match_parent" android:layout_height="250dp" android:layout_marginTop="8dp"
                    android:adjustViewBounds="true" android:background="@drawable/msn_preview_frame" android:contentDescription="Anteprima convertita"
                    android:padding="4dp" android:scaleType="fitCenter" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/msn_panel" android:orientation="vertical" android:padding="12dp">
                    <TextView style="@style/Widget.PixelSheet.PanelTitle" android:text="3.1 Statistiche e legenda" />
                    <TextView android:id="@+id/statisticsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Genera una conversione per visualizzare i risultati." android:textColor="@color/soft_text" android:textIsSelectable="true" android:textSize="14sp" />
                </LinearLayout>
                <TextView style="@style/Widget.PixelSheet.PanelTitle" android:layout_marginTop="12dp" android:text="3.2 Esportazione" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:baselineAligned="false" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/exportPngButton" style="@style/Widget.PixelSheet.ActionButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:enabled="false" android:text="SALVA PNG" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/exportXlsxButton" style="@style/Widget.PixelSheet.ActionButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:enabled="false" android:text="SALVA XLSX" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/backToCameraButton" style="@style/Widget.PixelSheet.ActionButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:text="NUOVO" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/msn_toolbar" android:maxLines="1"
        android:paddingHorizontal="12dp" android:paddingVertical="7dp"
        android:text="Pronto" android:textColor="@color/soft_muted" android:textSize="12sp" />
</LinearLayout>
