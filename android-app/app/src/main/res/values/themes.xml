<resources>
    <style name="Theme.PixelSheet" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#3FAFD0</item>
        <item name="android:navigationBarColor">#DCE4E8</item>
        <item name="android:statusBarColor">#4C9FC1</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.PixelSheet.ActionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#174F78</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="backgroundTint">#F7FAFB</item>
        <item name="cornerRadius">3dp</item>
        <item name="strokeColor">#879BA5</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.PixelSheet.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#174F78</item>
        <item name="backgroundTint">#FFFFFF</item>
        <item name="cornerRadius">5dp</item>
        <item name="strokeColor">#63CF2D</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.PixelSheet.NavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#174F78</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">2dp</item>
        <item name="backgroundTint">@color/msn_nav_tint</item>
    </style>

    <style name="Widget.PixelSheet.CameraOverlayButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#66358EAD</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeColor">#E9FAFF</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.PixelSheet.CameraCaptureButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#174F78</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#FFFFFF</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeColor">#65CF2E</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.PixelSheet.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#174F78</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="Widget.PixelSheet.PanelTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#25799A</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.PixelSheet.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#66727A</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.PixelSheet.FieldRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.PixelSheet.FieldName" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#20262B</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.PixelSheet.NumberInput" parent="">
        <item name="android:layout_width">104dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/input_frame</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textColor">#20262B</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
